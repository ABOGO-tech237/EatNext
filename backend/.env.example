# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Vercel (production) — exemples :
# APP_URL=https://eatnext-api.vercel.app
# CLIENT_URL=https://eatnext.vercel.app
# OSM_SYNC_ON_START=false
# OSM_SYNC_INTERVAL_HOURS=0
# CRON_SECRET=long-random-secret-for-vercel-cron

# Database
DATABASE_URL=postgresql://eatnext:eatnext@localhost:5432/eatnext

# JWT
JWT_SECRET=change-me-256-bit-random-secret-please-rotate
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=change-me-256-bit-random-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=604800

# Redis
REDIS_URL=redis://localhost:6379

# OpenStreetMap / Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=15000

# Remplissage dynamique PostgreSQL depuis OpenStreetMap (Yaoundé + Douala par défaut)
# JSON : [{"name":"Yaoundé","lat":3.8667,"lng":11.5167,"radius":8000,"limit":150}, ...]
OSM_SYNC_ZONES=
OSM_SYNC_ON_START=true
OSM_SYNC_INTERVAL_HOURS=24
# true lors de db:bootstrap — supprime les restaurants hors OSM (anciennes données fictives)
OSM_PURGE_NON_OSM=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=eatnext
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=noreply@eatnext.africa

# OpenStreetMap / Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=60000
OVERPASS_MAX_RETRIES=3
OVERPASS_USER_AGENT=EatNext/1.0 (dev@eatnext.africa)
