# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://eatnext:eatnext@localhost:5432/eatnext

# JWT
JWT_SECRET=change-me-256-bit-random-secret-please-rotate
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=change-me-256-bit-random-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=604800

# Redis
REDIS_URL=redis://localhost:6379

# OpenStreetMap / Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=15000

# Cloudinary
CLOUDINARY_CLOUD_NAME=eatnext
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=noreply@eatnext.africa

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
