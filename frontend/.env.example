# URL de l'API EatNext (backend Express).
# En local, `/v1` passe par le proxy Vite (voir vite.config.ts).
VITE_API_URL=/v1

# true = données mock locales (sans backend). false = API réelle obligatoire.
VITE_USE_MOCK=false

# Vercel (production) — remplacer par l'URL du projet backend :
# VITE_API_URL=https://eatnext-api.vercel.app/v1
